# Auth Apps Script -> service này
API_BEARER_TOKEN=

# Gemini qua Developer API (KHÔNG qua Vertex AI - gemini-3.x chưa có quyền dùng qua Vertex AI
# cho project này dù đã enable trong Model Garden, xem PLAN_vertex_ai_billing_draft.md).
# GEMINI_API_KEY phải tạo gắn với project GCP này (Google AI Studio -> Create API key -> Search
# Google Cloud projects -> chọn đúng project) để billing dồn về đúng Cloud Billing Account,
# không phải tài khoản cá nhân.
GEMINI_API_KEY=
GEMINI_ANALYSIS_MODEL=gemini-3.1-pro-preview
GEMINI_SYNTHESIS_MODEL=gemini-3.7-flash

# OAuth refresh token cố định để đọc Google Drive (xem scripts/get_refresh_token.py)
DRIVE_CLIENT_ID=
DRIVE_CLIENT_SECRET=
DRIVE_REFRESH_TOKEN=

# Firestore
GCP_PROJECT_ID=
FIRESTORE_DATABASE=video-agent-db
FIRESTORE_COLLECTION=video_agent_jobs

# Cloud Tasks (để trống khi chạy local -> job chạy bằng BackgroundTasks trong tiến trình)
CLOUD_TASKS_QUEUE=
CLOUD_TASKS_LOCATION=asia-southeast1
PROCESS_JOB_BASE_URL=

# Secret riêng bảo vệ endpoint nội bộ /internal/process-job (chỉ Cloud Tasks biết)
INTERNAL_TASK_TOKEN=

# Giới hạn xử lý
MAX_VIDEOS_PER_JOB=10
MAX_VIDEO_DURATION_SECONDS=300
DEFAULT_TARGET_DURATION_MIN_SECONDS=30
DEFAULT_TARGET_DURATION_MAX_SECONDS=60
